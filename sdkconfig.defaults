# TLS: verify servers against the ESP-IDF built-in x509 certificate bundle
# (full bundle, ~130 well-known roots). No hardcoded PEMs in firmware.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_MAX_CERTS=200
# 服务器链顶是 GlobalSign Root CA (R1) 跨签的 GTS Root R4，默认 bundle 无 R1。
# 证书文件随项目提交（certs/globalsign-root-ca-r1.pem），构建时附加进 bundle
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="certs/globalsign-root-ca-r1.pem"
# GTS (Google Trust Services) 根证书及服务器链使用 P-384 曲线，必须启用
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=y
