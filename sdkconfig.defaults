# TLS: verify servers against the ESP-IDF built-in x509 certificate bundle
# (CMN = common roots, 36 authorities incl. DigiCert Global Root G2 —
# api.meatsuger.top 链：TrustAsia DV TLS RSA CA 2025 → DigiCert Global Root G2).
# No hardcoded PEMs in firmware.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y


# --- Partition table: custom layout (see partitions.csv) ---
# ESP32-S3-WROOM-1-N16R8: 16 MB flash. factory = 4 MB app partition.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
