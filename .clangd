# 宿主 clangd 不支持 xtensa,剥掉交叉参数,用宿主 triple 只做语法检查。
# esp-clangd 不带内建头,resource-dir 借 esp-clang；picolibc 补 sys/features.h。
CompileFlags:
  Remove:
    - -f*
    - -m*
    - --target=*
    - -specs=*
    - --sysroot=*
    - -gdwarf-*
    - -ggdb*
    - -o*
  Add:
    - --target=x86_64-unknown-linux-gnu
    - -resource-dir=/home/yu/.espressif/tools/esp-clang/esp-21.1.3_20260408/esp-clang/lib/clang/21
    - -D__XTENSA__
    - -DSSIZE_MAX=9223372036854775807L
    - -isystem/home/yu/.espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/picolibc/include
    - -Wall
    - -Wextra
    - -Wno-unknown-attributes
    - -Wno-unknown-warning-option
